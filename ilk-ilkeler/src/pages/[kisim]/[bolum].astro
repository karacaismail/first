---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TermLayer from '../../components/TermLayer';
import glossary from '../../data/glossary.json';
import { BOOK, CHAPTERS, partOf, chapterPath, chapterLabel } from '../../data/book';

export async function getStaticPaths() {
  const entries = await getCollection('bolumler');
  return entries.map((entry) => ({ params: { kisim: entry.data.part, bolum: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const all = (await getCollection('bolumler')).sort((a, b) => a.data.order - b.data.order);
const idx = all.findIndex((e) => e.id === entry.id);
const prev = idx > 0 ? all[idx - 1].data : null;
const next = idx < all.length - 1 ? all[idx + 1].data : null;
const part = partOf(entry.data.part);
const def = CHAPTERS.find((c) => c.unit === entry.data.unit)!;
const label = chapterLabel(def);
const path = chapterPath(entry.data);
const termMap: Record<string, { key: string; tr: string; explanation: string; slug: string }> = {};
for (const t of glossary as any[]) {
  if (!entry.data.terms.includes(t.key)) continue;
  const o = entry.data.termOverrides[t.key];
  termMap[t.key] = { key: t.key, tr: o?.tr ?? t.tr, explanation: o?.explanation ?? t.explanation, slug: t.slug };
}
const [p0, p1] = entry.data.pages;
const pageText = p0 && p1 ? (p0 === p1 ? `s. ${p0}` : `s. ${p0}–${p1}`) : null;
const minutes = Math.max(1, Math.round(entry.data.words / 200));
const site = Astro.site!.href.replace(/\/$/, '');
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Chapter',
    name: entry.data.title,
    alternateName: entry.data.titleEn,
    description: entry.data.description,
    position: entry.data.order,
    inLanguage: 'tr',
    url: site + path,
    isPartOf: {
      '@type': 'Book',
      name: BOOK.title,
      alternateName: BOOK.titleEn,
      inLanguage: 'tr',
      author: { '@type': 'Person', name: BOOK.author },
      translationOfWork: { '@type': 'Book', name: BOOK.titleEn, inLanguage: 'en', author: { '@type': 'Person', name: BOOK.author }, datePublished: '1900' },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: BOOK.title, item: site + '/' },
      { '@type': 'ListItem', position: 2, name: `${part.label}${part.label !== part.title ? ' · ' + part.title : ''}`, item: `${site}/${part.slug}/` },
      { '@type': 'ListItem', position: 3, name: entry.data.title, item: site + path },
    ],
  },
];
---
<Base title={`${label ? label + ' · ' : ''}${entry.data.title}`} description={entry.data.description} current={path} type="article" jsonLd={jsonLd}>
  <div class="page">
    <nav aria-label="Konum">
      <ol class="crumbs">
        <li><a href="/">{BOOK.title}</a></li>
        <li aria-hidden="true">›</li>
        <li><a href={`/${part.slug}/`}>{part.label}{part.label !== part.title ? ` · ${part.title}` : ''}</a></li>
        <li aria-hidden="true">›</li>
        <li aria-current="page">{entry.data.title}</li>
      </ol>
    </nav>
    <article data-pagefind-body data-pagefind-filter="tur:Bölüm" data-pagefind-meta={`kisim:${part.label}${part.label !== part.title ? " · " + part.title : ""}`}>
      <header>
        {label && <p class="eyebrow" data-pagefind-ignore>{label}</p>}
        <h1 class="title">{entry.data.title}</h1>
        <p class="subtitle" lang="en">{entry.data.titleEn}</p>
        <div class="meta" data-pagefind-ignore>
          {pageText && <span>Özgün baskıda {pageText}</span>}
          {entry.data.sections.length > 0 && <span>§ {entry.data.sections[0]}–{entry.data.sections[entry.data.sections.length - 1]}</span>}
          <span>Yaklaşık {minutes} dakika okuma</span>
        </div>
        {entry.data.summary && <p class="lead" data-pagefind-ignore>{entry.data.summary}</p>}
        {entry.data.sections.length > 3 && (
          <nav aria-label="Kesimler" class="secstrip" data-pagefind-ignore>
            {entry.data.sections.map((s) => <a href={`#paragraf-${s}`}>§ {s}</a>)}
          </nav>
        )}
      </header>
      <div class="prose">
        <Content />
      </div>
    </article>
    <nav class="pager" aria-label="Önceki ve sonraki bölüm" data-pagefind-ignore>
      {prev ? (
        <a class="prev" href={chapterPath(prev)} rel="prev"><span class="dir">← Önceki</span>{prev.title}</a>
      ) : <span />}
      {next ? (
        <a class="next" href={chapterPath(next)} rel="next"><span class="dir">Sonraki →</span>{next.title}</a>
      ) : <span />}
    </nav>
  </div>
  <TermLayer client:load terms={termMap} />
</Base>
